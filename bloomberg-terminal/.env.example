# OpenBerg config — copy to .env and fill in. Everything is optional.
# Get free keys:
#   FRED:    https://fred.stlouisfed.org/docs/api/api_key.html  (free, 120 req/min)
#   Finnhub: https://finnhub.io  (free, ~60 calls/min, personal use)
FRED_API_KEY=
FINNHUB_API_KEY=

# DEMO_MODE: auto (live w/ demo fallback) | always (offline demo) | never (live only)
DEMO_MODE=auto

# Server
PORT=8000
